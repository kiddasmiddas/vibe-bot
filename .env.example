# Bot
BOT_TOKEN=123456:CHANGE_ME

# Webhook (prod). Для локалки можно оставить пустыми и использовать polling.
WEBHOOK_HOST=https://example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-please

# Database (для приложения — async; для Alembic будет преобразовано в sync вариант)
DATABASE_URL=postgresql+asyncpg://vibe:vibe@postgres:5432/vibe

# Redis (FSM storage + кэш настроек/модерации)
REDIS_URL=redis://redis:6379/0

# Платежи (ЮKassa через Telegram Payments)
YOOKASSA_PROVIDER_TOKEN=

# Админы
ADMIN_TELEGRAM_IDS=

# Логирование / окружение
LOG_LEVEL=INFO
ENVIRONMENT=dev

# Mini App («Аллея креаторов»)
MINIAPP_URL=https://bot.example.com/app/
API_BASE_URL=https://bot.example.com/api

# NSFW / NudeNet
NUDENET_MODEL_PATH=models/nudenet.onnx
NSFW_THRESHOLD=0.7
